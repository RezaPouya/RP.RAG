{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rp_rag_db;Username=rp_user;Password=rp_pass"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "ProductIndexName": "products",
    "RequestTimeoutSeconds": 30
  },
  "DataSeederWorkerOptions": {
    "BatchSize": 500
  },
  "ProductIndexerWorker": {
    "PollIntervalSeconds": 30
  },
  "EmbeddingWorker": {
    "PollIntervalSeconds": 5,
    "BatchSize": 5,
    "MaxChunksPerBatch": 2000
  },
  "Ollama": {
    "Url": "http://localhost:11434",
    "EmbeddingModel": "bge-m3:latest",
    "GenerationModel": "gemma4:e4b"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient.Ollama": "Warning"
    }
  },
  "Seed": {
    "DataRoot": "../../data"
  }
}

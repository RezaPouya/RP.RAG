{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rp_rag_db;Username=rp_user;Password=rp_pass"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "ProductIndexName": "products",
    "RequestTimeoutSeconds": 30
  },
  "Generation": {
    "Provider": "Ollama" // "DeepSeek" or "Ollama"
  },
  "Ollama": {
    "Url": "http://localhost:11434",
    "EmbeddingModel": "bge-m3:latest",
    "GenerationModel": "gemma4:e4b",
    "Temperature": 0.2,
    "RequestTimeoutSeconds": 120
  },
  "DeepSeek": {
    "Url": "https://api.deepseek.com",
    "ApiKey": "",
    "GenerationModel": "deepseek-flash",
    "Temperature": 0.2,
    "RequestTimeoutSeconds": 120
  },
  "Laya": {
    "Url": "http://localhost:8090",
    "ApiKey": "",
    "RequestTimeoutSeconds": 30,
    "JailbreakThreshold": 0.5,
    "PromptInjectionThreshold": 0.5,
    "PolicyViolationThreshold": 0.5,
    "ChunkPromptInjectionThreshold": 0.5,
    "FinalJailbreakThreshold": 0.5,
    "FinalPromptInjectionThreshold": 0.5
  },
  "Ask": {
    "TopProducts": 5,
    "ChunksPerProduct": 2,
    "IncludePartiallyRelevantChunks": false,
    "MaxQuestionLength": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

@page "/chat/{ConversationId:guid}"
@attribute [Authorize]
@using Markdig
@using System.Text.RegularExpressions
@using RP.RAG.Application.Ask
@using RP.RAG.Application.Catalog
@inject IAskService AskService
@inject RP.Rag.Application.Conversations.IConversationMemoryService ConversationService
@inject IProductCatalogService CatalogService
@inject AuthenticationStateProvider AuthStateProvider

<style>
    .chat-container {
        height: calc(100vh - 150px);
    }

    .message-bubble {
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .user-bubble {
        background-color: #f8f9fa;
        border-left: 5px solid #0d6efd;
    }

    .assistant-bubble {
        background-color: #ffffff;
        border-left: 5px solid #198754;
        border: 1px solid #dee2e6;
    }

    /* Markdown Styling */
    .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 {
        margin-top: 1rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .markdown-body p {
        margin-bottom: 0.75rem;
        line-height: 1.6;
    }

    .markdown-body ul, .markdown-body ol {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }

    .markdown-body li {
        margin-bottom: 0.25rem;
    }

    .markdown-body hr {
        border-top: 2px dashed #dee2e6;
        margin: 1.5rem 0;
    }

    .markdown-body strong {
        font-weight: 600;
    }

    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.1) !important;
        }
</style>

<div class="d-flex flex-column chat-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Chat with Catalog Assistant</h3>
        @if (lastResponseTimeMs > 0)
        {
            <span class="badge bg-info fs-6">Last Response: @lastResponseTimeMs ms</span>
        }
    </div>

    <div class="flex-grow-1 overflow-auto border rounded p-4 mb-3 bg-light">
        @if (messages.Count == 0 && !isLoading)
        {
            <div class="alert alert-info text-center">No messages yet. Ask a question to start.</div>
        }

        @foreach (var msg in messages)
        {
            <div class="message-bubble @(msg.Role == "user" ? "user-bubble" : "assistant-bubble")">
                <div class="d-flex align-items-center mb-2">
                    <strong class="@(msg.Role == "user" ? "text-primary" : "text-success") fs-5">
                        @(msg.Role == "user" ? "👤 You" : "🤖 Assistant")
                    </strong>
                    @if (!string.IsNullOrEmpty(msg.ElapsedTimeMs))
                    {
                        <span class="badge bg-secondary ms-2">@msg.ElapsedTimeMs ms</span>
                    }
                </div>

                @if (msg.Role == "user")
                {
                    <p class="mb-0 fs-5 text-dark" style="white-space: pre-wrap;">@msg.Content</p>
                }
                else
                {
                    @if (msg.IsBlocked)
                    {
                        <div class="alert alert-warning mb-3">
                            <strong>⚠️ Blocked:</strong> @msg.BlockReason
                        </div>
                    }

                    <!-- RENDER MARKDOWN HERE -->
                    <div class="markdown-body">
                        @((MarkupString)RenderMarkdown(msg.Content, msg.Products))
                    </div>

                    <!-- RENDER PRODUCT CARDS -->
                    @if (msg.Products is { Count: > 0 })
                    {
                        <hr />
                        <h5 class="text-muted mb-3">📦 Referenced Products</h5>
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                            @for (int i = 0; i < msg.Products.Count; i++)
                            {
                                var product = msg.Products[i];
                                var refNumber = i + 1;
                                <div class="col">
                                    <div class="card h-100 shadow-sm border-primary product-card" id="product-@refNumber">
                                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                            <span class="badge bg-primary fs-6">[@refNumber]</span>
                                            <small class="text-muted fw-bold">@product.CategoryName</small>
                                        </div>
                                        <div class="card-body">
                                            <h6 class="card-title fw-bold text-dark">@product.Name</h6>
                                            <p class="card-text small text-muted">@product.Summary</p>
                                            <ul class="list-unstyled small mb-0 mt-3">
                                                <li><strong>SKU:</strong> <code>@product.Sku</code></li>
                                                <li class="mt-1"><strong>Price:</strong> <span class="text-success fw-bold fs-5">$@product.Price.ToString("N2")</span></li>
                                                <li class="mt-1">
                                                    <strong>Stock:</strong>
                                                    @if (product.InStock)
                                                    {
                                                        <span class="badge bg-success">In Stock (@product.StockCount)</span>
                                                    }
                                                    else
                                                    {

                                                        <span class="badge bg-danger">Out of Stock</span>
                                                    }
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="input-group input-group-lg">
        <input type="text" class="form-control" placeholder="Ask your question..."
               @bind="newMessage" @onkeydown="HandleKeyDown" disabled="@isSending" />
        <button class="btn btn-primary" @onclick="SendMessage" disabled="@isSending">
            @if (isSending)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {

                <span>Send</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public Guid ConversationId { get; set; }

    private List<ChatMessageDto> messages = new();
    private string newMessage = "";
    private bool isSending = false;
    private bool isLoading = true;
    private long lastResponseTimeMs = 0;
    private string? currentUserId;

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private sealed class ChatMessageDto
    {
        public string Role { get; set; } = "";
        public string Content { get; set; } = "";
        public string? ElapsedTimeMs { get; set; }
        public bool IsBlocked { get; set; }
        public string? BlockReason { get; set; }
        public IReadOnlyList<ProductCard>? Products { get; set; }
    }

    private string RenderMarkdown(string content, IReadOnlyList<ProductCard>? products)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var markdown = content;

        // Convert [n] references to clickable anchor links
        if (products is { Count: > 0 })
        {
            for (int i = 0; i < products.Count; i++)
            {
                var refNum = i + 1;
                markdown = Regex.Replace(markdown, $@"\[{refNum}\](?!\()", $@"<a href=""#product-{refNum}"" class=""fw-bold text-primary text-decoration-none"">[{refNum}]</a>");
            }
        }
        return Markdown.ToHtml(markdown, _pipeline);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(currentUserId)) { isLoading = false; return; }

        var conversation = await ConversationService.GetAsync(currentUserId, ConversationId);
        if (conversation is not null)
        {
            foreach (var m in conversation.Messages)
            {
                var dto = new ChatMessageDto { Role = m.Role, Content = m.Content };

                // Re-fetch product cards from PostgreSQL for history
                if (m.ProductIds is { Count: > 0 })
                {
                    var cards = await CatalogService.GetCardsAsync(m.ProductIds, onlyActive: true);
                    dto.Products = m.ProductIds.Where(id => cards.ContainsKey(id)).Select(id => cards[id]).ToList();
                }
                messages.Add(dto);
            }
        }
        isLoading = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !isSending) await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || isSending || string.IsNullOrEmpty(currentUserId)) return;

        isSending = true;
        var question = newMessage;
        newMessage = "";
        messages.Add(new ChatMessageDto { Role = "user", Content = question });
        StateHasChanged();

        try
        {
            var response = await AskService.AskAsync(currentUserId, question, topProducts: 5, conversationId: ConversationId);
            lastResponseTimeMs = response.TookMs;

            messages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = response.Answer,
                ElapsedTimeMs = response.TookMs.ToString(),
                IsBlocked = response.IsBlocked,
                BlockReason = response.BlockReason,
                Products = response.Products
            });
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessageDto { Role = "assistant", Content = $"Error: {ex.Message}", IsBlocked = true, BlockReason = "Error" });
        }

        isSending = false;
        StateHasChanged();
    }
}
@using RP.Rag.Web.Services
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService AuthService
@inject IHttpContextAccessor HttpContextAccessor

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">RP.RAG</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><NavLink class="nav-link" href="/" Match="NavLinkMatch.All">جستجو</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="/conversations">گفتگوهای من</NavLink></li>
                </ul>
                <AuthorizeView>
                    <Authorized>
                        <span class="navbar-text me-3">@context.User.Identity?.Name</span>
                        <button class="btn btn-outline-light btn-sm" @onclick="Logout">خروج</button>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-outline-light btn-sm" href="/login">ورود</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <main class="container mt-4 flex-grow-1">
        @Body
    </main>

    <footer class="bg-light py-3 text-center">
        <div class="container">RP.RAG - @DateTime.Now.Year</div>
    </footer>
</div>

@code {
    private async Task Logout()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            await AuthService.SignOutAsync(httpContext);
            Nav.NavigateTo("/login", forceLoad: true);
        }
    }
}